 "steps": [
  {
   "id": "inserts",
   "title": "Heat-set inserts",
   "text": "Print the four body quarters (side wall down, no supports) and press the brass inserts into every boss with a soldering iron at 245 \u00b0C: seams, cap tabs, feet, bay and stand mounts.",
   "parts": [
    "bodyRearLeft",
    "bodyRearRight",
    "bodyFrontLeft",
    "bodyFrontRight",
    "hwShell0",
    "hwShell2",
    "hwShell4"
   ]
  },
  {
   "id": "body",
   "title": "Join the body",
   "text": "Bolt the quarters together along the internal seam strips: M3 button screws into the inserts. The rear quarters' front strip is the stray-light baffle; the continuous strips also keep light out of the seams.",
   "parts": [
    "hwShell1",
    "hwShell3"
   ]
  },
  {
   "id": "feet",
   "title": "Levelling feet",
   "text": "Four M5 rubber levelling feet screw into the floor. Set them so the housing sits level and still on this dash, with 14 mm under the floor for the fan's air.",
   "parts": [
    "feet",
    "hwFeet0"
   ]
  },
  {
   "id": "bay",
   "title": "PGU bay",
   "text": "The sealed bay for the backlight's heat sink, fan and HDMI board bolts to the floor over the floor opening. The fan blows out through the grille in the duct; fresh air comes in through the slots fore and aft.",
   "parts": [
    "bay",
    "hwBay0",
    "hwBay1",
    "hwBay2",
    "hwBay3"
   ]
  },
  {
   "id": "grommets",
   "title": "Cable grommets and access plugs",
   "text": "TPU grommets seal the HDMI and LED lead exits in the bay floor and the sensor-lead port in the left wall. Three plugs close the front-wall holes that a ball-end key uses to reach the mirror adjusters.",
   "parts": [
    "grommetWall",
    "grommetHdmi",
    "grommetLed",
    "accessPlug1",
    "accessPlug2",
    "accessPlug3"
   ]
  },
  {
   "id": "carrier",
   "title": "Panel carrier",
   "text": "The carrier closes the bay. Its pocket holds the cell by the edges at the traced height, 0.5 mm over the backlight's IR-cut glass.",
   "parts": [
    "carrier"
   ]
  },
  {
   "id": "mask",
   "title": "Panel mask",
   "text": "The mask clamps the cell's edges. Its opening is the traced footprint on the panel plus 3 mm, so it never clips a ray from the eye box.",
   "parts": [
    "mask",
    "hwPanel0",
    "hwPanel1"
   ]
  },
  {
   "id": "fold",
   "title": "Fold bracket",
   "text": "The bracket holds the cold mirror 50 mm over the panel at 35\u00b0 incidence. Its cheeks stand on the carrier and share the bay's corner screws, so panel and fold are one rigid module.",
   "parts": [
    "foldBracket",
    "hwPanel2",
    "hwPanel3"
   ]
  },
  {
   "id": "stand",
   "title": "Mirror stand",
   "text": "The stand screws to the front floor across the centre seam. Its legs sit outboard of the adjusters so a key can reach every screw head.",
   "parts": [
    "mirrorStand",
    "hwMirrorA1"
   ]
  },
  {
   "id": "strongback",
   "title": "Strongback and adjusters",
   "text": "The mirror is bonded to the ribbed strongback on three RTV pads. Three M4 screws with springs, bed-levelling style, pull it against the stand and set its tilt during calibration.",
   "parts": [
    "strongback",
    "hwMirrorA0",
    "hwMirrorB0",
    "hwMirrorB2"
   ]
  },
  {
   "id": "clips",
   "title": "Mirror edge clips",
   "text": "Two clips catch the mirror's bottom edge, outside the traced footprint, in case the bond lets go.",
   "parts": [
    "mirrorClipL",
    "mirrorClipR",
    "hwMirrorB1",
    "hwMirrorB3"
   ]
  },
  {
   "id": "vanes",
   "title": "Light-trap vanes",
   "text": "Saw-tooth vanes on the side walls of the mirror bay trap sunlight that would otherwise light the walls the driver sees round the mirror.",
   "parts": [
    "vaneL",
    "vaneR"
   ]
  },
  {
   "id": "lid",
   "title": "Lid pieces",
   "text": "The four lid pieces print face down. They join with half laps and countersunk screws, so the underside the shutter runs on stays flat.",
   "parts": [
    "capRearLeft",
    "capRearRight",
    "capFrontLeft",
    "capFrontRight",
    "hwShell6",
    "hwShell7",
    "hwShell8",
    "hwShell9",
    "hwShell10",
    "hwShutter5"
   ]
  },
  {
   "id": "rails",
   "title": "Shutter rails and brackets",
   "text": "Two rails per side screw under the lid, with a slot for each leaf. The servo hangs from a bracket under the right rail; the spring's anchor post sits under the front rim.",
   "parts": [
    "railLeftRear",
    "railLeftFront",
    "railRightRear",
    "railRightFront",
    "servoBracket",
    "springAnchor",
    "hwShutter0",
    "hwShutter1",
    "hwShutter2",
    "hwShutter3",
    "hwShutter4"
   ]
  },
  {
   "id": "leaves",
   "title": "Shutter leaves",
   "text": "Two 0.5 mm black-anodised aluminium leaves, laser cut, slide into the rails. The front leaf carries the slot the servo's lever pin drives.",
   "parts": [
    "leafRear",
    "leafFront"
   ]
  },
  {
   "id": "capOn",
   "title": "Lid onto the body",
   "text": "The lid's spigot tabs drop inside the body walls; M3 button screws through the walls hold it. No tools are needed to lift the housing off the dash, only to open it.",
   "parts": [
    "hwShell5"
   ]
  },
  {
   "id": "glass",
   "title": "Dust-cover glass",
   "text": "3 mm glass with the s-pass polariser laminated underneath sits in the lid's rebate on a foam gasket, flush with the top. Eight clamps hold its edges.",
   "parts": [
    "coverGlass",
    "clamps",
    "hwClamps0"
   ]
  },
  {
   "id": "als",
   "title": "Light-sensor pod",
   "text": "The ambient-light sensor's pod sits on the lid behind the glass; its lead runs down the left wall's channel.",
   "parts": [
    "alsPod"
   ]
  }
